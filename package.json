{
  "name": "kitchen",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\""
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "endOfLine": "lf",
    "jsxSingleQuote": false,
    "printWidth": 80,
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
